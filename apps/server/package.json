{
  "name": "@tx-holdem-coach/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:service",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration --exclude \"**/database-infrastructure.test.ts\" --passWithNoTests",
    "test:service": "vitest run --dir test/service --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm run build && node scripts/migrate-production.mjs",
    "db:test:integration": "node scripts/run-database-integration-tests.mjs",
    "db:test:milestone": "node scripts/run-database-integration-tests.mjs",
    "db:test:full": "node scripts/run-database-integration-tests.mjs --full",
    "db:test:cleanup": "node scripts/run-database-integration-tests.mjs --cleanup-stale",
    "verify:migration-assets": "node scripts/verify-migration-assets.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@tx-holdem-coach/contracts": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "pokersolver": "2.1.4",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
