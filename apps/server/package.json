{
  "name": "@tx-holdem-coach/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm run test:unit && pnpm run test:service",
    "test:unit": "vitest run --dir test/unit",
    "test:service": "vitest run --dir test/service --passWithNoTests",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage --passWithNoTests",
    "eval:player:deterministic": "tsx eval/player/run-player-deterministic-eval.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm run build && node scripts/migrate-production.mjs",
    "db:test:integration": "node scripts/run-database-integration-tests.mjs --suite=database",
    "db:test:milestone": "node scripts/run-database-integration-tests.mjs --suite=database",
    "db:test:full": "node scripts/run-database-integration-tests.mjs --suite=database --full",
    "postgres:e2e:milestone": "node scripts/run-database-integration-tests.mjs --suite=e2e",
    "postgres:e2e:full": "node scripts/run-database-integration-tests.mjs --suite=e2e --full",
    "db:test:rebaseline": "pnpm run build && pnpm run verify:migration-assets && node scripts/rebaseline-test-database.mjs",
    "db:test:cleanup": "node scripts/run-database-integration-tests.mjs --suite=database --cleanup-stale",
    "db:test:connections": "node scripts/run-database-integration-tests.mjs --suite=database --connections",
    "verify:migration-assets": "node scripts/verify-migration-assets.mjs"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.28",
    "@hono/node-server": "^1.14.0",
    "@tx-holdem-coach/contracts": "workspace:*",
    "ai": "^7.0.68",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "pokersolver": "2.1.4",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.9.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
