{
  "name": "@tx-holdem-coach/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tx-holdem-coach/contracts run build && vite",
    "build": "pnpm --filter @tx-holdem-coach/contracts run build && tsc -p tsconfig.json && vite build",
    "typecheck": "pnpm --filter @tx-holdem-coach/contracts run build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @tx-holdem-coach/contracts run build && vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@tx-holdem-coach/contracts": "workspace:*",
    "eventsource-parser": "3.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "7.18.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "3.2.7"
  }
}
